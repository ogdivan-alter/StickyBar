<Window x:Class="StickyBar.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:StickyBar.App.Docking"
        xmlns:converters="clr-namespace:StickyBar.App.Converters"
        xmlns:input="clr-namespace:StickyBar.App.Input"
        xmlns:coreDocking="clr-namespace:StickyBar.Core.Docking;assembly=StickyBar.Core"
        xmlns:coreServices="clr-namespace:StickyBar.Core.Services;assembly=StickyBar.Core"
        xmlns:interaction="clr-namespace:StickyBar.Core.Interaction;assembly=StickyBar.Core"
        Title="StickyBar"
        Width="120"
        Height="36"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <!--
        ADR-002 / ADR-003. The window is entirely client area (CaptionHeight = 0) so that the pointer events of E3 keep
        arriving; the drag is delegated to the native move loop through the DragCommand of the view model, triggered on
        the press because a left-click gesture fires on the release. The resize border and the glass frame are removed so
        that no invisible band steals clicks from neighbouring windows.

        The Width and Height above are only the size the window has before the docking coordinator applies the declared
        footprint of DockBarMetrics; from then on the size is whatever the coordinator sets with SetWindowPos.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:PngBytesToImageSourceConverter x:Key="PngBytesToImageSourceConverter" />
        <converters:RibbonOffsetToMarginConverter x:Key="RibbonOffsetToMarginConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- Windows 7 Aero Glass translucent brushes -->
        <LinearGradientBrush x:Key="Win7DarkGlassBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#CC4A5668" Offset="0.0" />
            <GradientStop Color="#CC232C3B" Offset="0.45" />
            <GradientStop Color="#D9161D27" Offset="0.50" />
            <GradientStop Color="#D91E2634" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="Win7LightGlassBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EEFFFFFF" Offset="0.0" />
            <GradientStop Color="#DDF0F5FB" Offset="0.45" />
            <GradientStop Color="#D4DCE6F2" Offset="0.50" />
            <GradientStop Color="#DCE8EFF8" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="Win7DarkTileGlassBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#44FFFFFF" Offset="0.0" />
            <GradientStop Color="#1EFFFFFF" Offset="0.48" />
            <GradientStop Color="#14000000" Offset="0.52" />
            <GradientStop Color="#22FFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="Win7DarkTileHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#66FFFFFF" Offset="0.0" />
            <GradientStop Color="#34FFFFFF" Offset="0.48" />
            <GradientStop Color="#1CFFFFFF" Offset="0.52" />
            <GradientStop Color="#38FFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="Win7DarkTileOpenBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#77FFFFFF" Offset="0.0" />
            <GradientStop Color="#44FFFFFF" Offset="0.48" />
            <GradientStop Color="#28FFFFFF" Offset="0.52" />
            <GradientStop Color="#48FFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="Win7LightTileGlassBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#AAFFFFFF" Offset="0.0" />
            <GradientStop Color="#55FFFFFF" Offset="0.48" />
            <GradientStop Color="#221A2433" Offset="0.52" />
            <GradientStop Color="#44FFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="Win7LightTileHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#CCFFFFFF" Offset="0.0" />
            <GradientStop Color="#77FFFFFF" Offset="0.48" />
            <GradientStop Color="#331A2433" Offset="0.52" />
            <GradientStop Color="#66FFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="Win7LightTileOpenBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EEFFFFFF" Offset="0.0" />
            <GradientStop Color="#99FFFFFF" Offset="0.48" />
            <GradientStop Color="#441A2433" Offset="0.52" />
            <GradientStop Color="#88FFFFFF" Offset="1.0" />
        </LinearGradientBrush>

        <Style TargetType="{x:Type Button}" x:Key="ShortcutButtonStyle">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
            <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Command" Value="{Binding LaunchCommand}" />
            <Setter Property="input:ShortcutDragDropBehavior.DragSourceItem" Value="{Binding}" />
            <Setter Property="input:ShortcutDragDropBehavior.ReorderCommand"
                    Value="{Binding DataContext.ReorderBarItemsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="input:ShortcutDragDropBehavior.DragStartedCommand"
                    Value="{Binding DataContext.BeginShortcutDragCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="input:ShortcutDragDropBehavior.DragEndedCommand"
                    Value="{Binding DataContext.EndShortcutDragCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInRibbon}" Value="True">
                    <Setter Property="input:ShortcutDragDropBehavior.ReorderCommand"
                            Value="{Binding DataContext.OpenRibbon.ReorderItemsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ShortcutItemTemplate">
            <Button Style="{StaticResource ShortcutButtonStyle}">
                <Button.ContextMenu>
                    <ContextMenu input:ContextMenuHoldBehavior.OpenedCommand="{Binding PlacementTarget.Tag.BeginContextMenuCommand, RelativeSource={RelativeSource Self}}"
                                 input:ContextMenuHoldBehavior.ClosedCommand="{Binding PlacementTarget.Tag.EndContextMenuCommand, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{Binding PlacementTarget.Tag.Strings.MoveToMainBar, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding MoveToBarCommand}"
                                  Visibility="{Binding IsInRibbon, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <MenuItem Header="{Binding PlacementTarget.Tag.Strings.MoveToRibbon, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  ItemsSource="{Binding AllRibbons}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="{x:Type MenuItem}">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="Command"
                                            Value="{Binding DataContext.MoveToRibbonCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Setter Property="CommandParameter" Value="{Binding Id}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{Binding PlacementTarget.Tag.Strings.MoveEarlier, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding MoveEarlierCommand}" />
                        <MenuItem Header="{Binding PlacementTarget.Tag.Strings.MoveLater, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding MoveLaterCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding PlacementTarget.Tag.Strings.Remove, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Command="{Binding RemoveCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="20"
                           Height="20"
                           Source="{Binding IconPngBytes, Converter={StaticResource PngBytesToImageSourceConverter}}" />
                    <TextBlock Text="{Binding Name}"
                               FontSize="8"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="34"
                               HorizontalAlignment="Center"
                               Foreground="{Binding DataContext.TabForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <!--
            Deployed surface. The slide and the fade are storyboards with literal values: Timeline.From and
            Timeline.Duration are not dependency properties, so the animation cannot receive the offset or the duration
            by binding (ADR-003, P5.b). The magnitude is the thickness gained when deploying, 96 - 36 = 60 units, and the
            duration is InteractionTimings.SlideMilliseconds, 0.16 s (deuda D-14, now checked by
            MainWindowStoryboardContractTests).

            ADR-004 D4: every storyboard stops its clock, and the value that remains on screen is the resting value
            declared by the state, never the last animated one. The resting opacity is 1 here and 0 in Collapsing, so the
            panel looks the same on the first deployment and on the hundredth (H-E3-06). Nothing is held, so nothing can
            outrank the next animation.
        -->
        <Style TargetType="{x:Type Button}" x:Key="RibbonTileButtonStyle">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource Win7DarkTileGlassBrush}" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <Border BorderBrush="#28FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="False">
                    <Setter Property="Background" Value="{StaticResource Win7LightTileGlassBrush}" />
                    <Setter Property="BorderBrush" Value="#66243447" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Win7DarkTileHoverBrush}" />
                    <Setter Property="BorderBrush" Value="#AAFFFFFF" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Win7LightTileHoverBrush}" />
                    <Setter Property="BorderBrush" Value="#99243447" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Win7DarkTileOpenBrush}" />
                    <Setter Property="BorderBrush" Value="#CCFFFFFF" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsOpen}" Value="True" />
                        <Condition Binding="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Win7LightTileOpenBrush}" />
                    <Setter Property="BorderBrush" Value="#BB243447" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Path}" x:Key="RibbonArrowPathStyle">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke"
                    Value="{Binding DataContext.TabForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Data" Value="M 2.5,4.5 L 6,8.5 L 9.5,4.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.DockEdge, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static coreDocking:DockEdge.Bottom}">
                    <Setter Property="Data" Value="M 2.5,8.5 L 6,4.5 L 9.5,8.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.DockEdge, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static coreDocking:DockEdge.Left}">
                    <Setter Property="Data" Value="M 4.5,2.5 L 8.5,6 L 4.5,9.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.DockEdge, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static coreDocking:DockEdge.Right}">
                    <Setter Property="Data" Value="M 8.5,2.5 L 4.5,6 L 8.5,9.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="CreateRibbonButtonStyle">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="Background" Value="#E8B84B" />
            <Setter Property="BorderBrush" Value="#AAFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0C050" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="PinBarButtonStyle">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{Binding TabForeground}" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#44FFFFFF" />
                    <Setter Property="Opacity" Value="1.0" />
                </Trigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter Property="Background" Value="#66E8B84B" />
                    <Setter Property="BorderBrush" Value="#CCE8B84B" />
                    <Setter Property="Opacity" Value="1.0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="InlineRibbonActionButtonStyle">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground"
                    Value="{Binding DataContext.TabForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#44FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type StackPanel}" x:Key="RibbonBodyOrientationStyle">
            <Setter Property="Orientation" Value="Vertical" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.DockEdge, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static coreDocking:DockEdge.Left}">
                    <Setter Property="Orientation" Value="Horizontal" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.DockEdge, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static coreDocking:DockEdge.Right}">
                    <Setter Property="Orientation" Value="Horizontal" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type WrapPanel}" x:Key="RibbonWrapOrientationStyle">
            <Setter Property="Orientation" Value="Vertical" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.DockEdge, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static coreDocking:DockEdge.Left}">
                    <Setter Property="Orientation" Value="Horizontal" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.DockEdge, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static coreDocking:DockEdge.Right}">
                    <Setter Property="Orientation" Value="Horizontal" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Border}" x:Key="ContentPanelStyle">
            <Setter Property="Background" Value="{StaticResource Win7DarkGlassBrush}" />
            <Setter Property="BorderBrush" Value="#77FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLightTheme}" Value="False">
                    <Setter Property="Background" Value="{StaticResource Win7LightGlassBrush}" />
                    <Setter Property="BorderBrush" Value="#77243447" />
                </DataTrigger>
                <!-- Nothing is deployed while the bar is collapsed or arming, so the surface is not even laid out. -->
                <DataTrigger Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Tab}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Arming}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>

                <!-- Deployed against the top edge: the content enters from beyond the top of the screen. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Top}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    From="-60" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <!-- Deployed against the bottom edge: the content enters from below. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Bottom}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    From="60" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <!-- Deployed against the left edge: the content enters from the left. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Left}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                    From="-60" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <!-- Deployed against the right edge: the content enters from the right. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Right}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                    From="60" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <!-- Floating bar: it has no edge to come from, so it only fades in (ADR-003, §12 #9). -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <!--
                    Slide-out: a fade, because the specified animation is the deployment (§4.3-01, §12 #11). ADR-004 D4:
                    the value left on screen is the resting value of Collapsing, declared here as a setter, and the fade
                    lasts as long as the settle (0.16 s = InteractionTimings.SlideMilliseconds), so the panel stays
                    painted while the window shrinks and goes dark exactly when the window has its folded footprint.
                -->
                <DataTrigger Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Collapsing}">
                    <Setter Property="Opacity" Value="0" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Idle tab: the only drag handle and the visual anchor in both states (ADR-003, D3 and invariant I3). It keeps
            its position on screen while the bar deploys, so it carries no translation and no margin.

            When docked to an edge, it renders as a slim Win7 glass capsule flush with the edge and showing only an
            inward chevron. When floating (DockEdge == null), it shows the app icon and the "StickyBar" label.
        -->
        <Style TargetType="{x:Type Border}" x:Key="TabBorderStyle">
            <Setter Property="Background" Value="{StaticResource Win7DarkGlassBrush}" />
            <Setter Property="BorderBrush" Value="#77FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0,0,7,7" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Opacity" Value="0.95" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLightTheme}" Value="False">
                    <Setter Property="Background" Value="{StaticResource Win7LightGlassBrush}" />
                    <Setter Property="BorderBrush" Value="#77243447" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Bottom}">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Bottom" />
                    <Setter Property="CornerRadius" Value="7,7,0,0" />
                    <Setter Property="Width" Value="56" />
                    <Setter Property="Height" Value="14" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Left}">
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="CornerRadius" Value="0,7,7,0" />
                    <Setter Property="Width" Value="14" />
                    <Setter Property="Height" Value="56" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Right}">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="CornerRadius" Value="7,0,0,7" />
                    <Setter Property="Width" Value="14" />
                    <Setter Property="Height" Value="56" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Null}">
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Padding" Value="10,4" />
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="Auto" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>

                <!-- Micro-expansion of HU02 CA #2: 1.06 of the tab during ~120 ms, before the bar is fully deployed. -->
                <DataTrigger Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Arming}">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                    To="1.06" Duration="0:0:0.06" AutoReverse="True" />
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                    To="1.06" Duration="0:0:0.06" AutoReverse="True" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Ribbon flyout panel (E4-CA1, E4-CA2, Q-10): visible only while the bar is Expanded and a ribbon is open.
            Narrow strip aligned under/beside its indicator button; slides perpendicularly into the screen with
            FillBehavior="Stop" (ADR-004 D4).
        -->
        <Style TargetType="{x:Type Border}" x:Key="RibbonPanelStyle">
            <Setter Property="Background" Value="{StaticResource Win7DarkGlassBrush}" />
            <Setter Property="BorderBrush" Value="#77FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLightTheme}" Value="False">
                    <Setter Property="Background" Value="{StaticResource Win7LightGlassBrush}" />
                    <Setter Property="BorderBrush" Value="#77243447" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Bottom}">
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="VerticalAlignment" Value="Bottom" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Left}">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="54" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Right}">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="54" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding HasOpenRibbon}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>

                <!-- Horizontal bar at Top or Floating: ribbon slides down into the screen. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding HasOpenRibbon}" Value="True" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Top}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    From="-24" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding HasOpenRibbon}" Value="True" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    From="-24" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <!-- Horizontal bar at Bottom: ribbon slides up into the screen. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding HasOpenRibbon}" Value="True" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Bottom}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    From="24" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <!-- Vertical bar at Left: ribbon slides right into the screen. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding HasOpenRibbon}" Value="True" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Left}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                    From="-24" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <!-- Vertical bar at Right: ribbon slides left into the screen. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding HasOpenRibbon}" Value="True" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Right}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                    From="24" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Places the main bar at the docked edge with fixed thickness (52) so opening a ribbon never stretches it (E4-CA1, E4-CA7). -->
        <Style TargetType="{x:Type Border}" x:Key="BarSlotStyle" BasedOn="{StaticResource ContentPanelStyle}">
            <Setter Property="DockPanel.Dock" Value="Top" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Width" Value="Auto" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Bottom}">
                    <Setter Property="DockPanel.Dock" Value="Bottom" />
                    <Setter Property="Height" Value="52" />
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="VerticalAlignment" Value="Bottom" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Left}">
                    <Setter Property="DockPanel.Dock" Value="Left" />
                    <Setter Property="Width" Value="52" />
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Right}">
                    <Setter Property="DockPanel.Dock" Value="Right" />
                    <Setter Property="Width" Value="52" />
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type StackPanel}" x:Key="RibbonStripOrientationStyle">
            <Setter Property="Orientation" Value="Horizontal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Left}">
                    <Setter Property="Orientation" Value="Vertical" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Right}">
                    <Setter Property="Orientation" Value="Vertical" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type StackPanel}" x:Key="BarMainStackStyle" BasedOn="{StaticResource RibbonStripOrientationStyle}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Left}">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Right}">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type StackPanel}" x:Key="FloatingTabContentStyle">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Path}" x:Key="DockedTabChevronStyle">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{Binding TabForeground}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility" Value="Visible" />
            <Setter Property="Data" Value="M 1,3 L 5,7 L 9,3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Bottom}">
                    <Setter Property="Data" Value="M 1,7 L 5,3 L 9,7" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Left}">
                    <Setter Property="Data" Value="M 3,1 L 7,5 L 3,9" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Right}">
                    <Setter Property="Data" Value="M 7,1 L 3,5 L 7,9" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!--
        ADR-004 D1: an interactive region is announced by the element that paints, and only by that element. The
        invariant is "paint => hit-test => region", and its useful converse is "no paint => no input => no region": in a
        layered window a pixel with alpha 0 is click-through, so the system never delivers the pointer there and WPF
        never raises an entry —or, worse, an entry without its exit— for it.

        Therefore the root neither paints nor reports. It only lays out, and it still does not clip: clipping here would
        cut the micro-expansion of the tab against the window border. The window keeps its own Background="Transparent"
        on purpose; that belongs to the window, not to this panel, and it is what keeps the window hit-testable (deuda
        D-15, unchanged by this decision).
    -->
    <Grid x:Name="RootPanel">
        <Grid x:Name="ClipPanel" ClipToBounds="True">
            <DockPanel LastChildFill="True">
                <!--
                    ADR-004 D1: the panel reports the Bar region itself, exactly as the tab always did. Its own entry is
                    real: the panel is not an ancestor of the tab, so moving from the tab into the panel raises its own
                    MouseEnter. While the bar is collapsed the panel is Collapsed, so it cannot report anything at all, and
                    E1-CA4 keeps depending on the window measuring exactly the tab footprint.
                -->
                <Border x:Name="ContentPanel"
                        Style="{StaticResource BarSlotStyle}"
                        Padding="3"
                        input:PointerRegionBehavior.Region="{x:Static interaction:DockRegion.Bar}"
                        input:PointerRegionBehavior.EnterCommand="{Binding EnterRegionCommand}"
                        input:PointerRegionBehavior.LeaveCommand="{Binding LeaveRegionCommand}"
                        input:ShortcutDragDropBehavior.ExternalDropCommand="{Binding DropFilesOnBarCommand}">
                    <Border.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </Border.RenderTransform>

                    <StackPanel Style="{StaticResource BarMainStackStyle}">
                        <!-- Subtle 3-dot grip indicator at the start of the bar -->
                        <Border x:Name="GripDragHandle"
                                Background="Transparent"
                                Padding="4,6"
                                Cursor="SizeAll"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                ToolTip="{Binding Strings.DragHandleToolTip}"
                                behaviors:PressDragBehavior.Command="{Binding DragCommand}">
                            <TextBlock Text="⋮"
                                       Width="14"
                                       Height="14"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       Opacity="0.45"
                                       Margin="0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{Binding TabForeground}" />
                        </Border>

                        <!-- App icon container at the start of the bar (after grip) -->
                        <Border Width="34"
                                Height="34"
                                Margin="2"
                                Padding="2"
                                CornerRadius="8"
                                Background="#22FFFFFF"
                                BorderBrush="#44FFFFFF"
                                BorderThickness="1">
                            <Image Width="28"
                                   Height="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Source="pack://application:,,,/Icons/stickybar-64x64.png"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <ItemsControl ItemsSource="{Binding BarItems}"
                                      ItemTemplate="{StaticResource ShortcutItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Style="{StaticResource RibbonStripOrientationStyle}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Ribbons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Style="{StaticResource RibbonStripOrientationStyle}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RibbonTileButtonStyle}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Command="{Binding ToggleCommand}"
                                            input:ShortcutDragDropBehavior.ExternalDropCommand="{Binding DropFilesCommand}"
                                            input:ShortcutDragDropBehavior.TargetRibbon="{Binding}"
                                            input:ShortcutDragDropBehavior.MoveToRibbonCommand="{Binding AcceptInternalShortcutCommand}">
                                        <Button.ContextMenu>
                                            <ContextMenu input:ContextMenuHoldBehavior.OpenedCommand="{Binding PlacementTarget.Tag.BeginContextMenuCommand, RelativeSource={RelativeSource Self}}"
                                                         input:ContextMenuHoldBehavior.ClosedCommand="{Binding PlacementTarget.Tag.EndContextMenuCommand, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{Binding PlacementTarget.Tag.Strings.MoveEarlier, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          Command="{Binding MoveEarlierCommand}" />
                                                <MenuItem Header="{Binding PlacementTarget.Tag.Strings.MoveLater, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          Command="{Binding MoveLaterCommand}" />
                                                <Separator />
                                                <MenuItem Header="{Binding PlacementTarget.Tag.Strings.Delete, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          Command="{Binding DeleteCommand}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>

                                        <Grid Width="30" Height="30">
                                            <Path Style="{StaticResource RibbonArrowPathStyle}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,4" />
                                            <TextBlock Text="{Binding DisplayNumber}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.75"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="{Binding DataContext.TabForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="+"
                                Style="{StaticResource CreateRibbonButtonStyle}"
                                Command="{Binding CreateRibbonCommand}"
                                ToolTip="{Binding Strings.CreateRibbonToolTip}" />

                        <Button x:Name="PinBarButton"
                                Content="📌"
                                Style="{StaticResource PinBarButtonStyle}"
                                Command="{Binding TogglePinCommand}"
                                ToolTip="{Binding Strings.PinBarToolTip}" />
                    </StackPanel>
                </Border>

                <!--
                    ADR-004 D1 / E3-CA3: the open ribbon reports DockRegion.Ribbon only while painted, preventing
                    accidental collapse when moving the pointer between the bar and the open ribbon.
                -->
                <Border x:Name="RibbonPanel"
                        Style="{StaticResource RibbonPanelStyle}"
                        input:PointerRegionBehavior.Region="{x:Static interaction:DockRegion.Ribbon}"
                        input:PointerRegionBehavior.EnterCommand="{Binding EnterRegionCommand}"
                        input:PointerRegionBehavior.LeaveCommand="{Binding LeaveRegionCommand}"
                        input:ShortcutDragDropBehavior.ExternalDropCommand="{Binding OpenRibbon.DropFilesCommand}"
                        input:ShortcutDragDropBehavior.TargetRibbon="{Binding OpenRibbon}"
                        input:ShortcutDragDropBehavior.MoveToRibbonCommand="{Binding OpenRibbon.AcceptInternalShortcutCommand}">
                    <Border.Margin>
                        <MultiBinding Converter="{StaticResource RibbonOffsetToMarginConverter}">
                            <Binding Path="OpenRibbonOffset" />
                            <Binding Path="DockEdge" />
                        </MultiBinding>
                    </Border.Margin>
                    <Border.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </Border.RenderTransform>

                    <ContentControl Content="{Binding OpenRibbon}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Style="{StaticResource RibbonBodyOrientationStyle}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <!-- Subtle ribbon number at the beginning of the deployed ribbon -->
                                    <TextBlock Text="{Binding DisplayNumber, StringFormat='#{0}'}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Opacity="0.7"
                                               Margin="2"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding DataContext.TabForeground, RelativeSource={RelativeSource AncestorType=Window}}" />

                                    <!-- Shortcuts arranged in a single column/row perpendicularly to the bar -->
                                    <ItemsControl ItemsSource="{Binding ShortcutItems}"
                                                  ItemTemplate="{StaticResource ShortcutItemTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Style="{StaticResource RibbonBodyOrientationStyle}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <!-- Edit button and inline management actions at the end of the ribbon -->
                                    <StackPanel Style="{StaticResource RibbonBodyOrientationStyle}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="2">
                                        <Button Content="✎"
                                                Style="{StaticResource InlineRibbonActionButtonStyle}"
                                                Command="{Binding ToggleActionsCommand}"
                                                ToolTip="{Binding DataContext.Strings.RibbonActionsToolTip, RelativeSource={RelativeSource AncestorType=Window}}" />

                                        <StackPanel Style="{StaticResource RibbonBodyOrientationStyle}"
                                                    Visibility="{Binding IsActionsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Button Content="◀"
                                                    Style="{StaticResource InlineRibbonActionButtonStyle}"
                                                    Command="{Binding MoveEarlierCommand}"
                                                    ToolTip="{Binding DataContext.Strings.MoveEarlier, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="▶"
                                                    Style="{StaticResource InlineRibbonActionButtonStyle}"
                                                    Command="{Binding MoveLaterCommand}"
                                                    ToolTip="{Binding DataContext.Strings.MoveLater, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="✕"
                                                    Style="{StaticResource InlineRibbonActionButtonStyle}"
                                                    Command="{Binding DeleteCommand}"
                                                    ToolTip="{Binding DataContext.Strings.DeleteRibbonToolTip, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Border>
            </DockPanel>
        </Grid>

        <Border x:Name="TabBorder"
                Panel.ZIndex="1"
                Style="{StaticResource TabBorderStyle}"
                behaviors:PressDragBehavior.Command="{Binding DragCommand}"
                input:PointerRegionBehavior.Region="{x:Static interaction:DockRegion.Tab}"
                input:PointerRegionBehavior.EnterCommand="{Binding EnterRegionCommand}"
                input:PointerRegionBehavior.LeaveCommand="{Binding LeaveRegionCommand}"
                input:ShortcutDragDropBehavior.ExternalDropCommand="{Binding DropFilesOnBarCommand}">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Grid>
                <StackPanel x:Name="FloatingTabContent" Style="{StaticResource FloatingTabContentStyle}">
                    <Image Width="20"
                           Height="20"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Source="pack://application:,,,/Icons/stickybar-64x64.png"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="StickyBar"
                               Foreground="{Binding TabForeground}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Path x:Name="DockedTabChevron" Style="{StaticResource DockedTabChevronStyle}" />
            </Grid>
        </Border>
    </Grid>
</Window>
