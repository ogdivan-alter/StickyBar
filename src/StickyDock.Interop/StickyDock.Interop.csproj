<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Win32 interoperability boundary. Every P/Invoke of the product lives here, wrapped in safe types
    (AGENTS.md). `AllowUnsafeBlocks` is required by the LibraryImport source generator.
  -->
  <PropertyGroup>
    <RootNamespace>StickyDock.Interop</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StickyDock.Core\StickyDock.Core.csproj" />
  </ItemGroup>

</Project>
