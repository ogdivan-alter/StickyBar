<Window x:Class="StickyDock.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sticky Dock Utility - Settings"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Interaction"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding GracePeriodMilliseconds, StringFormat={}{0} ms}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
                <TextBlock Text="Collapse grace period"
                           VerticalAlignment="Center" />
            </DockPanel>

            <Slider Minimum="{Binding GracePeriodMinimum}"
                    Maximum="{Binding GracePeriodMaximum}"
                    TickFrequency="10"
                    SmallChange="10"
                    LargeChange="50"
                    IsSnapToTickEnabled="False"
                    Value="{Binding GracePeriodMilliseconds, Mode=TwoWay}"
                    Margin="0,4,0,4" />

            <TextBlock Text="Delay before collapsing after the pointer leaves the bar (300–500 ms)."
                       FontSize="11"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="System"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <CheckBox Content="Start automatically with Windows"
                      IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}"
                      Margin="0,0,0,8" />

            <DockPanel LastChildFill="True">
                <TextBlock Text="Current dock position: "
                           Opacity="0.7" />
                <TextBlock Text="{Binding DockedEdgeLabel}"
                           FontWeight="SemiBold" />
            </DockPanel>
        </StackPanel>

        <Separator Grid.Row="2" Margin="0,0,0,12" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Close"
                    Width="88"
                    Padding="12,6"
                    IsDefault="True"
                    Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>
