<Window x:Class="StickyDock.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Strings.SettingsWindowTitle}"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding Strings.SettingsInteractionHeader}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding GracePeriodMilliseconds, StringFormat={}{0} ms}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
                <TextBlock Text="{Binding Strings.SettingsGracePeriodLabel}"
                           VerticalAlignment="Center" />
            </DockPanel>

            <Slider Minimum="{Binding GracePeriodMinimum}"
                    Maximum="{Binding GracePeriodMaximum}"
                    TickFrequency="10"
                    SmallChange="10"
                    LargeChange="50"
                    IsSnapToTickEnabled="False"
                    Value="{Binding GracePeriodMilliseconds, Mode=TwoWay}"
                    Margin="0,4,0,4" />

            <TextBlock Text="{Binding Strings.SettingsGracePeriodDescription}"
                       FontSize="11"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="{Binding Strings.SettingsSystemHeader}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <CheckBox Content="{Binding Strings.SettingsAutoStartLabel}"
                      IsChecked="{Binding AutoStartEnabled, Mode=TwoWay}"
                      Margin="0,0,0,8" />

            <DockPanel LastChildFill="True" Margin="0,0,0,8">
                <TextBlock DockPanel.Dock="Left"
                           Text="{Binding Strings.SettingsLanguageLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <ComboBox ItemsSource="{Binding AvailableLanguages}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Code"
                          SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                          Width="160"
                          HorizontalAlignment="Right" />
            </DockPanel>

            <DockPanel LastChildFill="True">
                <TextBlock Text="{Binding Strings.SettingsDockPositionLabel}"
                           Opacity="0.7" />
                <TextBlock Text="{Binding DockedEdgeLabel}"
                           FontWeight="SemiBold" />
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="{Binding Strings.SettingsReplicaHeader}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding SecondaryMonitors}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSecondaryMonitors}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayLabel}"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  Margin="0,0,0,6" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Strings.SettingsNoSecondaryMonitors}"
                       FontSize="11"
                       Opacity="0.7"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoSecondaryMonitors}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <Separator Grid.Row="3" Margin="0,0,0,12" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{Binding Strings.SettingsCloseButton}"
                    Width="88"
                    Padding="12,6"
                    IsDefault="True"
                    Command="{Binding CloseCommand}" />
        </StackPanel>
    </Grid>
</Window>
