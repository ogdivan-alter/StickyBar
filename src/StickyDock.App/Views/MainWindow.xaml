<Window x:Class="StickyDock.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:docking="clr-namespace:StickyDock.App.Docking"
        Title="Sticky Dock Utility"
        Width="120"
        Height="36"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <!--
        ADR-002: the window is entirely client area (CaptionHeight = 0) so that the pointer events of E1 and E3 keep
        arriving; the drag is delegated to the native move loop through the DragCommand of the view model, triggered on
        the press because a left-click gesture fires on the release. The resize border and the glass frame are removed
        so that no invisible band steals clicks from neighbouring windows.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="{x:Type Border}" x:Key="TabBorderStyle">
            <Setter Property="Background" Value="{Binding TabBackground}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Opacity" Value="0.9" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="{Binding ScaleX}" ScaleY="{Binding ScaleY}" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="TabBorder" Style="{StaticResource TabBorderStyle}"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                IsHitTestVisible="True"
                docking:PressDragBehavior.Command="{Binding DragCommand}">
            <TextBlock Text="Sticky" Foreground="{Binding TabForeground}" FontSize="11" />
        </Border>
    </Grid>
</Window>
