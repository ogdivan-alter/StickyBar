<Window x:Class="StickyDock.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sticky Dock Utility"
        Width="320"
        Height="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <!--
        Placeholder shell built on the E0 foundations. E1 replaces this surface with the borderless dock bar and its
        idle tab; the bindings already target the view model so no state lives in the view.
    -->
    <Border Background="#CC202020" CornerRadius="10" Padding="16,10">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Sticky Dock Utility"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold" />
            <TextBlock Text="{Binding StatusText}"
                       Foreground="#B0FFFFFF"
                       FontSize="11"
                       Margin="0,2,0,0" />
        </StackPanel>
    </Border>
</Window>
