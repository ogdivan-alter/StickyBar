<Window x:Class="StickyDock.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:StickyDock.App.Docking"
        xmlns:converters="clr-namespace:StickyDock.App.Converters"
        xmlns:input="clr-namespace:StickyDock.App.Input"
        xmlns:coreDocking="clr-namespace:StickyDock.Core.Docking;assembly=StickyDock.Core"
        xmlns:coreServices="clr-namespace:StickyDock.Core.Services;assembly=StickyDock.Core"
        xmlns:interaction="clr-namespace:StickyDock.Core.Interaction;assembly=StickyDock.Core"
        Title="Sticky Dock Utility"
        Width="120"
        Height="36"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <!--
        ADR-002 / ADR-003. The window is entirely client area (CaptionHeight = 0) so that the pointer events of E3 keep
        arriving; the drag is delegated to the native move loop through the DragCommand of the view model, triggered on
        the press because a left-click gesture fires on the release. The resize border and the glass frame are removed so
        that no invisible band steals clicks from neighbouring windows.

        The Width and Height above are only the size the window has before the docking coordinator applies the declared
        footprint of DockBarMetrics; from then on the size is whatever the coordinator sets with SetWindowPos.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <converters:PngBytesToImageSourceConverter x:Key="PngBytesToImageSourceConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style TargetType="{x:Type Button}" x:Key="ShortcutButtonStyle">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
            <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
            <Setter Property="Command" Value="{Binding LaunchCommand}" />
            <Setter Property="input:ShortcutDragDropBehavior.DragSourceItem" Value="{Binding}" />
            <Setter Property="input:ShortcutDragDropBehavior.ReorderCommand"
                    Value="{Binding DataContext.ReorderBarItemsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInRibbon}" Value="True">
                    <Setter Property="input:ShortcutDragDropBehavior.ReorderCommand"
                            Value="{Binding DataContext.OpenRibbon.ReorderItemsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ShortcutItemTemplate">
            <Button Style="{StaticResource ShortcutButtonStyle}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Move to Main Bar"
                                  Command="{Binding MoveToBarCommand}"
                                  Visibility="{Binding IsInRibbon, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <MenuItem Header="Move to Ribbon"
                                  ItemsSource="{Binding AllRibbons}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="{x:Type MenuItem}">
                                    <Setter Property="Header" Value="{Binding Name}" />
                                    <Setter Property="Command"
                                            Value="{Binding DataContext.MoveToRibbonCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Setter Property="CommandParameter" Value="{Binding Id}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Move Earlier" Command="{Binding MoveEarlierCommand}" />
                        <MenuItem Header="Move Later" Command="{Binding MoveLaterCommand}" />
                        <Separator />
                        <MenuItem Header="Remove" Command="{Binding RemoveCommand}" />
                    </ContextMenu>
                </Button.ContextMenu>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="20"
                           Height="20"
                           Source="{Binding IconPngBytes, Converter={StaticResource PngBytesToImageSourceConverter}}" />
                    <TextBlock Text="{Binding Name}"
                               FontSize="8"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="34"
                               HorizontalAlignment="Center"
                               Foreground="{Binding DataContext.TabForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </Button>
        </DataTemplate>
        <!--
            Deployed surface. The slide and the fade are storyboards with literal values: Timeline.From and
            Timeline.Duration are not dependency properties, so the animation cannot receive the offset or the duration
            by binding (ADR-003, P5.b). The magnitude is the thickness gained when deploying, 96 - 36 = 60 units, and the
            duration is InteractionTimings.SlideMilliseconds, 0.16 s (deuda D-14, now checked by
            MainWindowStoryboardContractTests).

            ADR-004 D4: every storyboard stops its clock, and the value that remains on screen is the resting value
            declared by the state, never the last animated one. The resting opacity is 1 here and 0 in Collapsing, so the
            panel looks the same on the first deployment and on the hundredth (H-E3-06). Nothing is held, so nothing can
            outrank the next animation.
        -->
        <Style TargetType="{x:Type Button}" x:Key="RibbonTileButtonStyle">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#3843A047" />
            <Setter Property="BorderBrush" Value="#7766BB6A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5843A047" />
                    <Setter Property="BorderBrush" Value="#AA81C784" />
                </Trigger>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter Property="Background" Value="#7243A047" />
                    <Setter Property="BorderBrush" Value="#CC81C784" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Path}" x:Key="RibbonArrowPathStyle">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Stroke"
                    Value="{Binding DataContext.TabForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Data" Value="M 6,2 L 6,10 M 2.5,6.5 L 6,10 L 9.5,6.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.DockEdge, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static coreDocking:DockEdge.Bottom}">
                    <Setter Property="Data" Value="M 6,10 L 6,2 M 2.5,5.5 L 6,2 L 9.5,5.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.DockEdge, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static coreDocking:DockEdge.Left}">
                    <Setter Property="Data" Value="M 2,6 L 10,6 M 6.5,2.5 L 10,6 L 6.5,9.5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.DockEdge, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static coreDocking:DockEdge.Right}">
                    <Setter Property="Data" Value="M 10,6 L 2,6 M 5.5,2.5 L 2,6 L 5.5,9.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="CreateRibbonButtonStyle">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="Background" Value="#E8B84B" />
            <Setter Property="BorderBrush" Value="#AAFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0C050" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Button}" x:Key="InlineRibbonActionButtonStyle">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground"
                    Value="{Binding DataContext.TabForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#44FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type StackPanel}" x:Key="RibbonBodyOrientationStyle">
            <Setter Property="Orientation" Value="Vertical" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.DockEdge, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static coreDocking:DockEdge.Left}">
                    <Setter Property="Orientation" Value="Horizontal" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.DockEdge, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static coreDocking:DockEdge.Right}">
                    <Setter Property="Orientation" Value="Horizontal" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type WrapPanel}" x:Key="RibbonWrapOrientationStyle">
            <Setter Property="Orientation" Value="Vertical" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.DockEdge, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static coreDocking:DockEdge.Left}">
                    <Setter Property="Orientation" Value="Horizontal" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.DockEdge, RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="{x:Static coreDocking:DockEdge.Right}">
                    <Setter Property="Orientation" Value="Horizontal" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Border}" x:Key="ContentPanelStyle">
            <Setter Property="Background" Value="#D91B2432" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLightTheme}" Value="False">
                    <Setter Property="Background" Value="#DCF0F4FA" />
                    <Setter Property="BorderBrush" Value="#441A2433" />
                </DataTrigger>
                <!-- Nothing is deployed while the bar is collapsed or arming, so the surface is not even laid out. -->
                <DataTrigger Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Tab}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Arming}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>

                <!-- Deployed against the top edge: the content enters from beyond the top of the screen. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Top}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    From="-60" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <!-- Deployed against the bottom edge: the content enters from below. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Bottom}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    From="60" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <!-- Deployed against the left edge: the content enters from the left. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Left}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                    From="-60" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <!-- Deployed against the right edge: the content enters from the right. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Right}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                    From="60" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <!-- Floating bar: it has no edge to come from, so it only fades in (ADR-003, §12 #9). -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <!--
                    Slide-out: a fade, because the specified animation is the deployment (§4.3-01, §12 #11). ADR-004 D4:
                    the value left on screen is the resting value of Collapsing, declared here as a setter, and the fade
                    lasts as long as the settle (0.16 s = InteractionTimings.SlideMilliseconds), so the panel stays
                    painted while the window shrinks and goes dark exactly when the window has its folded footprint.
                -->
                <DataTrigger Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Collapsing}">
                    <Setter Property="Opacity" Value="0" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Idle tab: the only drag handle and the visual anchor in both states (ADR-003, D3 and invariant I3). It keeps
            its position on screen while the bar deploys, so it carries no translation and no margin.

            The tab is rotated on the vertical edges because its content-sized footprint (about 58x27 units) does not fit
            the 36-unit thickness that DockBarMetrics declares for those edges.
        -->
        <Style TargetType="{x:Type Border}" x:Key="TabBorderStyle">
            <Setter Property="Background" Value="{Binding TabBackground}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Opacity" Value="0.9" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Bottom}">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Bottom" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Left}">
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="LayoutTransform">
                        <Setter.Value>
                            <RotateTransform Angle="90" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Right}">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="LayoutTransform">
                        <Setter.Value>
                            <RotateTransform Angle="270" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>

                <!-- Micro-expansion of HU02 CA #2: 1.06 of the tab during ~120 ms, before the bar is fully deployed. -->
                <DataTrigger Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Arming}">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                    To="1.06" Duration="0:0:0.06" AutoReverse="True" />
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                    To="1.06" Duration="0:0:0.06" AutoReverse="True" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Ribbon flyout panel (E4-CA1, E4-CA2, Q-10): visible only while the bar is Expanded and a ribbon is open.
            Slides perpendicularly from the ribbon indicator into the interior of the screen with FillBehavior="Stop"
            (ADR-004 D4).
        -->
        <Style TargetType="{x:Type Border}" x:Key="RibbonPanelStyle">
            <Setter Property="Background" Value="#D91B2432" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Opacity" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLightTheme}" Value="False">
                    <Setter Property="Background" Value="#DCF0F4FA" />
                    <Setter Property="BorderBrush" Value="#441A2433" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding HasOpenRibbon}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>

                <!-- Horizontal bar at Top or Floating: ribbon slides down into the screen. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding HasOpenRibbon}" Value="True" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Top}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    From="-24" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding HasOpenRibbon}" Value="True" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    From="-24" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <!-- Horizontal bar at Bottom: ribbon slides up into the screen. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding HasOpenRibbon}" Value="True" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Bottom}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    From="24" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <!-- Vertical bar at Left: ribbon slides right into the screen. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding HasOpenRibbon}" Value="True" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Left}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                    From="-24" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>

                <!-- Vertical bar at Right: ribbon slides left into the screen. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DockState}" Value="{x:Static coreServices:DockState.Expanded}" />
                        <Condition Binding="{Binding HasOpenRibbon}" Value="True" />
                        <Condition Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Right}" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard FillBehavior="Stop">
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                    From="24" To="0" Duration="0:0:0.16" />
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.16" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Places the main bar at the docked edge so the open ribbon always expands inward (E4-CA1, E4-CA7). -->
        <Style TargetType="{x:Type Border}" x:Key="BarSlotStyle" BasedOn="{StaticResource ContentPanelStyle}">
            <Setter Property="DockPanel.Dock" Value="Top" />
            <Setter Property="Height" Value="96" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasOpenRibbon}" Value="False">
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Width" Value="Auto" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Bottom}">
                    <Setter Property="DockPanel.Dock" Value="Bottom" />
                    <Setter Property="Height" Value="96" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Left}">
                    <Setter Property="DockPanel.Dock" Value="Left" />
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Width" Value="96" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Right}">
                    <Setter Property="DockPanel.Dock" Value="Right" />
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Width" Value="96" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type StackPanel}" x:Key="RibbonStripOrientationStyle">
            <Setter Property="Orientation" Value="Horizontal" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Left}">
                    <Setter Property="Orientation" Value="Vertical" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DockEdge}" Value="{x:Static coreDocking:DockEdge.Right}">
                    <Setter Property="Orientation" Value="Vertical" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!--
        ADR-004 D1: an interactive region is announced by the element that paints, and only by that element. The
        invariant is "paint => hit-test => region", and its useful converse is "no paint => no input => no region": in a
        layered window a pixel with alpha 0 is click-through, so the system never delivers the pointer there and WPF
        never raises an entry —or, worse, an entry without its exit— for it.

        Therefore the root neither paints nor reports. It only lays out, and it still does not clip: clipping here would
        cut the micro-expansion of the tab against the window border. The window keeps its own Background="Transparent"
        on purpose; that belongs to the window, not to this panel, and it is what keeps the window hit-testable (deuda
        D-15, unchanged by this decision).
    -->
    <Grid x:Name="RootPanel">
        <Grid x:Name="ClipPanel" ClipToBounds="True">
            <DockPanel LastChildFill="True">
                <!--
                    ADR-004 D1: the panel reports the Bar region itself, exactly as the tab always did. Its own entry is
                    real: the panel is not an ancestor of the tab, so moving from the tab into the panel raises its own
                    MouseEnter. While the bar is collapsed the panel is Collapsed, so it cannot report anything at all, and
                    E1-CA4 keeps depending on the window measuring exactly the tab footprint.
                -->
                <Border x:Name="ContentPanel"
                        Style="{StaticResource BarSlotStyle}"
                        Padding="6"
                        input:PointerRegionBehavior.Region="{x:Static interaction:DockRegion.Bar}"
                        input:PointerRegionBehavior.EnterCommand="{Binding EnterRegionCommand}"
                        input:PointerRegionBehavior.LeaveCommand="{Binding LeaveRegionCommand}"
                        input:ShortcutDragDropBehavior.ExternalDropCommand="{Binding DropFilesOnBarCommand}">
                    <Border.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </Border.RenderTransform>

                    <StackPanel Style="{StaticResource RibbonStripOrientationStyle}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <!-- Subtle 3-dot grip indicator at the start of the bar -->
                        <TextBlock Text="⋮"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Opacity="0.45"
                                   Margin="2,0,4,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="{Binding TabForeground}" />

                        <ItemsControl ItemsSource="{Binding BarItems}"
                                      ItemTemplate="{StaticResource ShortcutItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Style="{StaticResource RibbonStripOrientationStyle}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Ribbons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Style="{StaticResource RibbonStripOrientationStyle}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RibbonTileButtonStyle}"
                                            Command="{Binding ToggleCommand}"
                                            input:ShortcutDragDropBehavior.ExternalDropCommand="{Binding DropFilesCommand}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Move Earlier" Command="{Binding MoveEarlierCommand}" />
                                                <MenuItem Header="Move Later" Command="{Binding MoveLaterCommand}" />
                                                <Separator />
                                                <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>

                                        <Grid Width="28" Height="28">
                                            <Path Style="{StaticResource RibbonArrowPathStyle}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,4,4" />
                                            <TextBlock Text="{Binding DisplayNumber}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Opacity="0.75"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="{Binding DataContext.TabForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="+"
                                Style="{StaticResource CreateRibbonButtonStyle}"
                                Command="{Binding CreateRibbonCommand}"
                                ToolTip="Create Ribbon" />

                        <!-- App icon container at the far end of the bar -->
                        <Border Width="28"
                                Height="28"
                                Margin="2"
                                Padding="3"
                                CornerRadius="8"
                                Background="#1AFFFFFF"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1">
                            <Image Width="20"
                                   Height="20"
                                   Source="pack://application:,,,/Icons/sticky-24x24.png"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </StackPanel>
                </Border>

                <!--
                    ADR-004 D1 / E3-CA3: the open ribbon reports DockRegion.Ribbon only while painted, preventing
                    accidental collapse when moving the pointer between the bar and the open ribbon.
                -->
                <Border x:Name="RibbonPanel"
                        Style="{StaticResource RibbonPanelStyle}"
                        input:PointerRegionBehavior.Region="{x:Static interaction:DockRegion.Ribbon}"
                        input:PointerRegionBehavior.EnterCommand="{Binding EnterRegionCommand}"
                        input:PointerRegionBehavior.LeaveCommand="{Binding LeaveRegionCommand}"
                        input:ShortcutDragDropBehavior.ExternalDropCommand="{Binding OpenRibbon.DropFilesCommand}">
                    <Border.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </Border.RenderTransform>

                    <StackPanel DataContext="{Binding OpenRibbon}"
                                Style="{StaticResource RibbonBodyOrientationStyle}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <!-- Subtle ribbon number at the beginning of the deployed ribbon -->
                        <TextBlock Text="{Binding DisplayNumber, StringFormat='#{0}'}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Opacity="0.7"
                                   Margin="4"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding DataContext.TabForeground, RelativeSource={RelativeSource AncestorType=Window}}" />

                        <!-- Shortcuts arranged perpendicularly to the bar -->
                        <ItemsControl ItemsSource="{Binding ShortcutItems}"
                                      ItemTemplate="{StaticResource ShortcutItemTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Style="{StaticResource RibbonWrapOrientationStyle}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Edit button and inline management actions at the end of the ribbon -->
                        <StackPanel Style="{StaticResource RibbonBodyOrientationStyle}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="2">
                            <Button Content="✎"
                                    Style="{StaticResource InlineRibbonActionButtonStyle}"
                                    Command="{Binding ToggleActionsCommand}"
                                    ToolTip="Ribbon Actions" />

                            <StackPanel Style="{StaticResource RibbonBodyOrientationStyle}"
                                        Visibility="{Binding IsActionsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Content="◀"
                                        Style="{StaticResource InlineRibbonActionButtonStyle}"
                                        Command="{Binding MoveEarlierCommand}"
                                        ToolTip="Move Earlier" />
                                <Button Content="▶"
                                        Style="{StaticResource InlineRibbonActionButtonStyle}"
                                        Command="{Binding MoveLaterCommand}"
                                        ToolTip="Move Later" />
                                <Button Content="✕"
                                        Style="{StaticResource InlineRibbonActionButtonStyle}"
                                        Command="{Binding DeleteCommand}"
                                        ToolTip="Delete Ribbon" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Grid>

        <Border x:Name="TabBorder"
                Panel.ZIndex="1"
                Style="{StaticResource TabBorderStyle}"
                behaviors:PressDragBehavior.Command="{Binding DragCommand}"
                input:PointerRegionBehavior.Region="{x:Static interaction:DockRegion.Tab}"
                input:PointerRegionBehavior.EnterCommand="{Binding EnterRegionCommand}"
                input:PointerRegionBehavior.LeaveCommand="{Binding LeaveRegionCommand}"
                input:ShortcutDragDropBehavior.ExternalDropCommand="{Binding DropFilesOnBarCommand}">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <TextBlock Text="Sticky" Foreground="{Binding TabForeground}" FontSize="11" />
        </Border>
    </Grid>
</Window>
