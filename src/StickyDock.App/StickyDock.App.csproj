<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPF shell (ADR-001). The application only composes services and hosts the view;
    state and behaviour belong to the view models and services of StickyDock.Core.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>StickyDock.App</RootNamespace>
    <AssemblyName>StickyDock</AssemblyName>

    <!-- AMP-03 (ADR-002): per-monitor DPI awareness for mixed-scale desktops (R-05). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- RNF-01 / Q-12: prioritize low committed private memory footprint. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\icons\sticky-24x24.png" Link="Icons\sticky-24x24.png" />
    <Resource Include="..\..\icons\sticky-32x32.png" Link="Icons\sticky-32x32.png" />
    <Resource Include="..\..\icons\sticky-64x64.png" Link="Icons\sticky-64x64.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StickyDock.Core\StickyDock.Core.csproj" />
    <ProjectReference Include="..\StickyDock.Interop\StickyDock.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System" />
  </ItemGroup>

</Project>
